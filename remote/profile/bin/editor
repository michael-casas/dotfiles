#!/bin/bash
set -eu
# No fallback silently loads an account vimrc. vi recovery is explicitly manual.
if ! command -v nvim >/dev/null 2>&1; then
    printf '%s\n' 'envi-remote: nvim unavailable; use vi -u NONE explicitly for recovery' >&2
    exit 25
fi
exec /usr/bin/env NVIM_APPNAME=envi-remote \
    XDG_CONFIG_HOME="$ENVI_REMOTE_RELEASE/config" \
    XDG_DATA_HOME="$ENVI_REMOTE_STATE/data" XDG_STATE_HOME="$ENVI_REMOTE_STATE/state" \
    XDG_CACHE_HOME="$ENVI_REMOTE_STATE/cache" \
    nvim -i NONE "$@"
