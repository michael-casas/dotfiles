{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "apiKeyHelper": "/bin/cat \"$HOME/.config/claude/gateway-key\"",
  "env": {
    "ANTHROPIC_BASE_URL": "https://gateway.example.invalid",
    "ANTHROPIC_API_KEY": "",
    "ANTHROPIC_AUTH_TOKEN": ""
  },
  "autoMode": {
    "soft_deny": [
      "$defaults"
    ],
    "environment": [
      "**Trusted repo**: <the project this profile is meant for>"
    ]
  }
}
