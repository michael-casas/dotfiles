#!/usr/bin/env bash
# envi-migrate: move envi into the default nvim profile (the production cutover).
#
#   envi-migrate [--dry-run] cutover        state, then links
#   envi-migrate [--dry-run] state | links  one of them
#   envi-migrate [--dry-run] rollback [<backup>]
#   envi-migrate backups                    list backups
#
# state builds a copy of ~/.local/state/nvim next to it, lays envi's shada/,
# undo/, hcmux/ and envi-hotreload.* over it (envi's file wins: envi is the
# daily editor), then swaps it in; the old folder moves into the backup.
# ~/.local/state/envi is only read: the T3 credential, swap files and the rest
# stay as they are. links points ~/.config/nvim and ~/.local/bin/envi{,-dev}
# at ~/.dotfiles and removes the ~/.config/envi link.
# Every check runs before the first write, and no nvim may be running. The
# backup (~/.backups/envi-migrate-*/) has a manifest written before any
# change; rollback undoes the newest backup, keeps the post-cutover state in
# <backup>/rollback-displaced/, and can be run again after an interruption.
# --allow-running is for tests only. See nvim/ENVI.md, "Cutover".
set -euo pipefail

self="$(readlink -f "${BASH_SOURCE[0]}")"
state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
bin_home="$HOME/.local/bin"
dotfiles="${DOTFILES:-$HOME/.dotfiles}"
backup_root="${ENVI_BACKUP_ROOT:-$HOME/.backups}"
src="$state_home/envi"
dst="$state_home/nvim"
dry=0
allow_running=0

say() { printf '%s\n' "$*"; }
die() {
  printf 'envi-migrate: %s\n' "$*" >&2
  exit 1
}
usage() {
  sed -n '2,7p' "$self" | sed 's/^# \{0,1\}//'
  exit 2
}

# Manifest values are hex, so any name or link target (newlines included) round-trips.
enc() { printf '%s' "$1" | od -An -v -tx1 | tr -d ' \n'; }
dec() { # <hex> <variable>
  [[ "$1" =~ ^([0-9a-f]{2})*$ ]] || die "corrupt manifest value: $1"
  # shellcheck disable=SC2059 # the format is only \xHH escapes built from hex
  printf -v "$2" "$(printf '%s' "$1" | sed 's/../\\x&/g')"
}
target_of() { # <link> <variable>: the exact target, trailing newlines included
  local _target_of
  _target_of="$(readlink -n -- "$1" && printf x)" || die "cannot read link $1"
  printf -v "$2" '%s' "${_target_of%x}"
}
fsid() { stat -c %d "$1" 2>/dev/null || stat -f %d "$1"; }
set_link() { # <path> <target>: replace the link in one rename
  local tmp
  tmp="$(dirname "$1")/.envi-migrate-link.$$"
  mkdir -p "$(dirname "$1")"
  rm -f -- "$tmp"
  ln -s "$2" "$tmp"
  if mv --version >/dev/null 2>&1; then mv -fT -- "$tmp" "$1"; else mv -fh "$tmp" "$1"; fi
}

# Every folder from $HOME down to <path> is real; <path> itself may be absent if $2=1.
real_chain() {
  local rest="${1#"$HOME"/}" cur="$HOME"
  case "$1" in "$HOME"/*) ;; *) die "$1 is outside \$HOME; refusing" ;; esac
  while [ -n "$rest" ]; do
    cur="$cur/${rest%%/*}"
    [ "${rest#*/}" = "$rest" ] && rest="" || rest="${rest#*/}"
    if [ -L "$cur" ] || { [ -e "$cur" ] && [ ! -d "$cur" ]; }; then die "$cur is not a real folder; refusing"; fi
    if [ ! -e "$cur" ]; then
      [ -z "$rest" ] && [ "$2" = 1 ] && return 0
      die "$cur is missing; refusing"
    fi
  done
}
no_editors() {
  local pids
  pids="$(pgrep -x -u "$(id -u)" nvim 2>/dev/null | tr '\n' ' ' || true)"
  [ -z "${pids// /}" ] && return 0
  [ "$allow_running" = 1 ] && return 0
  if [ "$dry" = 1 ]; then
    say "note: nvim is running (pid ${pids% }); close every nvim before applying"
  else
    die "nvim is running (pid ${pids% }). Close every nvim, envi and dev profiles included (:qd), then run again."
  fi
}

# Backups, oldest first: "<status> <path>" (applied, interrupted or rolled-back).
backups() {
  local b status
  for b in "$backup_root"/envi-migrate-*/; do
    [ -f "$b/manifest" ] || continue
    status=interrupted
    [ -e "$b/APPLIED" ] && status=applied
    [ -e "$b/ROLLED_BACK" ] && status=rolled-back
    printf '%s %s %s\n' "$(sed -n 's/^seq=//p' "$b/manifest")" "$status" "${b%/}"
  done | sort -n | cut -d' ' -f2-
}
get() { sed -n "s/^$1=//p" "$manifest" | head -n 1; }

# ── apply ────────────────────────────────────────────────────────────────

plan() { # sets do_state, do_links and the link plan; refuses before any write
  local part="$1" b status i old state_done=0
  while read -r status b; do
    if [ "$status" = interrupted ]; then
      die "an interrupted migration remains ($b); run envi-migrate rollback first"
    fi
    if [ "$status" = applied ] && grep -qx 'do_state=1' "$b/manifest"; then state_done="$b"; fi
  done < <(backups)
  do_state=0 do_links=0
  case "$part" in cutover) do_state=1 do_links=1 ;; state) do_state=1 ;; links) do_links=1 ;; esac
  if [ "$do_state" = 1 ] && [ "$state_done" != 0 ]; then
    say "state: already migrated (backup $state_done)"
    do_state=0
  fi
  if [ "$do_state" = 1 ]; then
    [ -L "$src" ] && die "$src is a link; refusing"
    if [ -d "$src" ]; then
      real_chain "$src" 0
      real_chain "$dst" 1
      for d in shada undo hcmux; do
        for p in "$src/$d" "$dst/$d"; do
          if [ -L "$p" ] || { [ -e "$p" ] && [ ! -d "$p" ]; }; then die "$p is not a real folder; refusing"; fi
        done
      done
    else
      say "state: no $src; nothing to bring over"
      do_state=0
    fi
  fi
  paths=() olds=() news=()
  if [ "$do_links" = 1 ]; then
    if ! { [ -f "$dotfiles/nvim/init.lua" ] && [ -x "$dotfiles/nvim/bin/envi-dev" ] && grep -q ENVI_DEV "$dotfiles/nvim/bin/envi"; }; then
      die "$dotfiles has no production launcher yet; merge it into main and fast-forward $dotfiles first"
    fi
    paths=("$config_home/nvim" "$bin_home/envi" "$bin_home/envi-dev" "$config_home/envi")
    news=("$dotfiles/nvim" "$dotfiles/nvim/bin/envi" "$dotfiles/nvim/bin/envi-dev" "")
    do_links=0
    for i in 0 1 2 3; do
      if [ -L "${paths[$i]}" ]; then
        target_of "${paths[$i]}" old
        olds[i]="L$old"
      elif [ -e "${paths[$i]}" ]; then
        die "${paths[$i]} is a real file or folder; move it aside, then run again"
      else
        olds[i]=A
      fi
      [ "${olds[$i]}" = "${news[$i]:+L}${news[$i]:-A}" ] || do_links=1
    done
    local dirty
    dirty="$(git --no-optional-locks -C "$dotfiles" status --short -- nvim/ 2>/dev/null || true)"
    if [ -n "$dirty" ]; then
      say "links: local changes in $dotfiles/nvim become part of production:"
      printf '%s\n' "$dirty" | sed 's/^/  /'
    fi
  fi
}

apply() {
  plan "$1"
  no_editors
  if [ "$do_state" = 0 ] && [ "$do_links" = 0 ]; then
    say "nothing to change"
    return 0
  fi
  local stamp seq i
  stamp="$(date +%Y%m%d-%H%M%S)-$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')"
  backup="$backup_root/envi-migrate-$stamp"
  staging="$state_home/nvim.envi-migrate.$stamp"
  if [ -L "$backup_root" ]; then die "$backup_root is a link; refusing"; fi
  if [ -e "$backup" ] || [ -e "$staging" ]; then die "$backup or $staging already exists"; fi
  local probe="$backup_root"
  while [ ! -e "$probe" ]; do probe="$(dirname "$probe")"; done
  [ "$(fsid "$probe")" = "$(fsid "$state_home")" ] || die "$backup_root and $state_home are on different filesystems"
  if [ "$dry" = 1 ]; then
    [ "$do_state" = 1 ] && say "would build $staging from $dst and envi's shada/ undo/ hcmux/ envi-hotreload.*, then swap it in"
    for i in 0 1 2 3; do
      if [ "${olds[$i]}" = "${news[$i]:+L}${news[$i]:-A}" ]; then continue; fi
      if [ -n "${news[$i]}" ]; then say "would link ${paths[$i]} -> ${news[$i]}"; else say "would remove ${paths[$i]}"; fi
    done
    say "dry run: nothing written"
    return 0
  fi
  seq=$(($(backups | wc -l) + 1))
  mkdir -p "$backup_root"
  mkdir -m 700 "$backup"
  manifest="$backup/manifest"
  {
    printf 'version=2\nseq=%s\ntime=%s\ndo_state=%s\ndo_links=%s\n' "$seq" "$stamp" "$do_state" "$do_links"
    printf 'state=%s\nstaging=%s\nstate_old=%s\n' "$(enc "$dst")" "$(enc "$staging")" "$([ -e "$dst" ] && echo present || echo absent)"
    for i in 0 1 2 3; do
      printf 'link%s_path=%s\nlink%s_old=%s\n' "$i" "$(enc "${paths[$i]:-}")" "$i" "$(enc "${olds[$i]:-}")"
    done
    printf 'end=1\n'
  } >"$manifest"
  say "backup: $backup"
  if [ "$do_state" = 1 ]; then
    if [ -e "$dst" ]; then cp -pR "$dst" "$staging"; else mkdir -m 700 "$staging"; fi
    local file rel
    while IFS= read -r -d '' file; do
      rel="${file#"$src"/}"
      case "$rel" in shada/*.tmp.*) continue ;; esac
      if [ -d "$file" ] && [ ! -L "$file" ]; then
        if [ -L "$staging/$rel" ] || { [ -e "$staging/$rel" ] && [ ! -d "$staging/$rel" ]; }; then rm -f -- "$staging/$rel"; fi
        [ -d "$staging/$rel" ] || mkdir -m 700 "$staging/$rel"
      else
        rm -rf -- "${staging:?}/$rel"
        cp -pR "$file" "$staging/$rel"
      fi
    done < <(
      for d in shada undo hcmux; do [ -d "$src/$d" ] && find "$src/$d" -print0; done
      find "$src" -maxdepth 1 -type f -name 'envi-hotreload.*' -print0
    )
    if [ -e "$dst" ]; then
      mv "$dst" "$backup/state-nvim"
      mv "$staging" "$dst" || {
        mv "$backup/state-nvim" "$dst"
        die "could not move the new state into place; nothing changed"
      }
    else
      mv "$staging" "$dst"
    fi
    say "state: $dst now holds envi's state (the old one: $backup/state-nvim)"
  fi
  if [ "$do_links" = 1 ]; then
    for i in 0 1 2 3; do
      if [ -z "${news[$i]}" ]; then
        [ -L "${paths[$i]}" ] && rm -f -- "${paths[$i]}" && say "removed ${paths[$i]}"
      elif [ "${olds[$i]}" != "L${news[$i]}" ]; then
        set_link "${paths[$i]}" "${news[$i]}" && say "linked ${paths[$i]} -> ${news[$i]}"
      fi
    done
  fi
  : >"$backup/APPLIED"
  local swaps=0
  [ -d "$src/swap" ] && swaps="$(find "$src/swap" -type f | wc -l | tr -d ' ')"
  [ "$swaps" = 0 ] || say "note: $swaps envi swap file(s) stay in $src/swap (recover with NVIM_APPNAME=envi nvim -r)"
  say "done; undo with: envi-migrate rollback $backup"
}

# ── rollback ─────────────────────────────────────────────────────────────

rollback() {
  local b="${1:-}" i n path old kind cur state="" staging="" staging_was=1
  if [ -z "$b" ]; then
    b="$(backups | { grep -v '^rolled-back ' || true; } | tail -n 1 | cut -d' ' -f2-)"
    [ -n "$b" ] || {
      say "rollback: no backup to roll back"
      return 0
    }
  fi
  b="${b%/}"
  manifest="$b/manifest"
  [ -f "$manifest" ] || die "$b has no manifest"
  [ -e "$b/ROLLED_BACK" ] && {
    say "rollback: $b was already rolled back"
    return 0
  }
  if ! grep -qx 'end=1' "$manifest" || [ "$(get version)" != 2 ]; then
    [ "$dry" = 1 ] || : >"$b/ROLLED_BACK" # torn before any change was made
    say "rollback: $b stopped before any change; nothing to undo"
    return 0
  fi
  dec "$(get state)" state
  dec "$(get staging)" staging
  # Check everything first: a link path that now holds real content blocks the rollback.
  if [ "$(get do_links)" = 1 ]; then
    for i in 0 1 2 3; do
      dec "$(get "link${i}_path")" path
      if [ -e "$path" ] && [ ! -L "$path" ]; then
        die "$path is now a real file or folder; leaving it. Move it aside, then run rollback again."
      fi
    done
  fi
  no_editors
  say "rollback: $b"
  if [ "$(get do_state)" = 1 ]; then
    [ -e "$staging" ] || staging_was=0
    if [ "$dry" = 1 ]; then
      say "would restore $state from $b/state-nvim (if present), keeping the current one in $b/rollback-displaced/"
    else
      [ -d "$staging" ] && [ ! -L "$staging" ] && rm -rf -- "$staging"
      # The current state is set aside, never overwritten: once restored, a retry finds no state-nvim.
      if { [ -e "$b/state-nvim" ] || { [ "$(get state_old)" = absent ] && [ "$staging_was" = 0 ]; }; } &&
        { [ -e "$state" ] || [ -L "$state" ]; }; then
        mkdir -p "$b/rollback-displaced"
        i=nvim n=1
        while [ -e "$b/rollback-displaced/$i" ] || [ -L "$b/rollback-displaced/$i" ]; do
          n=$((n + 1))
          i="nvim.$n"
        done
        mv "$state" "$b/rollback-displaced/$i"
        say "kept the post-cutover state in $b/rollback-displaced/$i"
      fi
      if [ -e "$b/state-nvim" ]; then
        mv "$b/state-nvim" "$state"
        say "restored $state"
      fi
    fi
  fi
  if [ "$(get do_links)" = 1 ]; then
    for i in 0 1 2 3; do
      dec "$(get "link${i}_path")" path
      dec "$(get "link${i}_old")" old
      kind="${old:0:1}"
      old="${old:1}"
      if [ "$kind" = A ]; then
        [ -L "$path" ] || continue
        if [ "$dry" = 1 ]; then say "would remove $path"; else rm -f -- "$path" && say "removed $path"; fi
      else
        if [ -L "$path" ]; then
          target_of "$path" cur
          [ "$cur" = "$old" ] && continue
        fi
        if [ "$dry" = 1 ]; then say "would link $path"; else set_link "$path" "$old" && say "linked $path"; fi
      fi
    done
  fi
  [ "$dry" = 1 ] && say "dry run: nothing written" && return 0
  : >"$b/ROLLED_BACK"
  say "rollback: done"
}

# ── main ─────────────────────────────────────────────────────────────────

cmd=""
arg=""
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run | -n) dry=1 ;;
    --allow-running) allow_running=1 ;;
    -*) usage ;;
    *) if [ -z "$cmd" ]; then cmd="$1"; else arg="$1"; fi ;;
  esac
  shift
done
case "$cmd" in
  cutover | state | links) apply "$cmd" ;;
  rollback) rollback "$arg" ;;
  backups) backups ;;
  *) usage ;;
esac
