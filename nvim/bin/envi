#!/usr/bin/env bash
# envi: the production nvim session. It runs the default nvim profile
# (~/.config/nvim -> ~/.dotfiles/nvim), attached to the herdr-core session
# "dotfiles" and running in ~/.dotfiles. See nvim/ENVI.md.
#
#   envi                  the dotfiles session (layout, buffers, terminals)
#   envi <file>...        those files in envi, no session (like nvim <file>)
#   envi ls | kill <name> manage sessions (nvim-session)
#
# Inside: :detach or :qd leaves the session; everything keeps running.
# :reload detaches and starts envi again on the same session, so config,
# plugin and launcher changes take effect.
#
# ENVI_DEV=<worktree> envi (or envi-dev) runs that worktree's nvim/ instead,
# under the profile envi-dev/<slot> and a dev-<slot> session: never production.
# envi-dev-protocol: 2
set -euo pipefail

self="$(readlink -f "${BASH_SOURCE[0]}")"
here="$(dirname "$self")"

die() {
  echo "envi: $*" >&2
  exit 1
}

[ -f "$here/envi-guard.sh" ] || die "$here/envi-guard.sh is missing"
# shellcheck source=nvim/bin/envi-guard.sh
. "$here/envi-guard.sh"

# Point `link` at `target`. A link that already points elsewhere, or a real
# folder, belongs to someone else: refuse rather than repoint it.
own_link() {
  local link="$1" target="$2" current
  if [ -L "$link" ]; then
    current="$(readlink -n -- "$link")" || die "cannot read $link"
    [ "$current" = "$target" ] && return 0
    die "$link points to $current, not $target; not repointing it (see envi-dev prune)."
  fi
  [ -e "$link" ] && die "$link exists and is not a link; not replacing it."
  mkdir -p -- "${link%/*}" || die "cannot create ${link%/*}"
  ln -s -- "$target" "$link" || die "cannot link $link"
}

# A dev profile folder is its own: absent, or a real folder with no link
# inside that could route writes elsewhere.
own_dir() {
  local dir="$1" links
  [ -e "$dir" ] || [ -L "$dir" ] || return 0
  if [ -L "$dir" ] || [ ! -d "$dir" ]; then
    die "$dir is not a real folder; refusing (envi-dev prune ${dir##*/} removes it)."
  fi
  links="$(find "$dir" -maxdepth 2 -type l -print)" || die "cannot inspect $dir"
  [ -z "$links" ] || die "$dir contains a link; refusing to write a dev profile through it."
}

if [ -n "${ENVI_DEV:-}" ]; then
  dev_root="$(cd "$ENVI_DEV" 2>/dev/null && pwd -P)" || die "ENVI_DEV: no such folder: $ENVI_DEV"
  [ -f "$dev_root/nvim/init.lua" ] || die "ENVI_DEV: $dev_root has no nvim/init.lua"
  # Its hcmux.session must declare the dev namespace (protocol 2) exactly.
  dev_protocol_ok "$dev_root/nvim/lua/hcmux/session.lua" ||
    die "$dev_root predates the dev profile (its hcmux/session.lua does not declare envi-dev-protocol 2); rebase it onto main."
  slot="$(dev_slot "$dev_root")"
  config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
  data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
  state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
  cache_home="${XDG_CACHE_HOME:-$HOME/.cache}"
  # Every dev root and its ancestors up to $HOME are real folders, and none
  # lies inside a production profile. Only the two declared links (config ->
  # worktree, plugin data -> production data) are links.
  for home in "$config_home" "$data_home" "$state_home" "$cache_home"; do
    real_chain "$home/envi-dev" "$home" absent-ok
    outside "$home/envi-dev/$slot" "$config_home/nvim" "$data_home/nvim" "$state_home/nvim" "$cache_home/nvim"
  done
  own_dir "$state_home/envi-dev/$slot"
  own_dir "$cache_home/envi-dev/$slot"
  data="$data_home/envi-dev/$slot"
  if [ -L "$data" ]; then
    target="$(readlink -n -- "$data")" || die "cannot read $data"
    [ "$target" = "$data_home/nvim" ] || die "$data points to $target, not $data_home/nvim; refusing."
  else
    own_dir "$data"
  fi
  own_link "$config_home/envi-dev/$slot" "$dev_root/nvim"
  if [ ! -e "$data" ] && [ ! -L "$data" ]; then
    mkdir -p -- "$data_home/envi-dev" || die "cannot create $data_home/envi-dev"
    ln -s -- "$data_home/nvim" "$data" || die "cannot link $data"
  fi
  export ENVI_DEV="$dev_root" NVIM_APPNAME="envi-dev/$slot"
  session_dir="$dev_root"
  default_session="dev-$slot"
  if [ -z "${ENVI_RELOAD_SESSION:-}" ]; then
    echo "envi: dev profile $NVIM_APPNAME ($dev_root)" >&2
  fi
else
  # Production is the default profile, whatever profile the caller runs in.
  unset NVIM_APPNAME
  session_dir="$HOME/.dotfiles"
  default_session=dotfiles
fi

case "${1:-}" in
  ls | list | kill | rm) exec "$here/nvim-session" "$@" ;;
  -h | --help | help) sed -n '2,16p' "$self" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

# A session start runs in the session's folder; `envi <file>` keeps the caller's cwd, like nvim.
if [ $# -eq 0 ] || [ -n "${ENVI_RELOAD_SESSION:-}${ENVI_SESSION:-}" ]; then
  cd "$session_dir"
fi
# A reload returns to the session it left; ENVI_SESSION picks another one.
# Both apply with or without arguments (e.g. `ENVI_SESSION=x envi --listen s`).
session="${ENVI_RELOAD_SESSION:-${ENVI_SESSION:-}}"
if [ -z "$session" ] && [ $# -eq 0 ]; then
  session="$default_session"
fi
if [ -n "$session" ]; then
  # Dev sessions always carry the dev- prefix (hcmux.session enforces it too).
  if [ -n "${ENVI_DEV:-}" ]; then
    case "$session" in dev-*) ;; *) session="dev-$session" ;; esac
  fi
  export HCMUX_SESSION="$session"
else
  unset HCMUX_SESSION # `envi <file>`: no session, even one inherited from a parent nvim
fi
unset ENVI_RELOAD_SESSION

# The TUI may return before its embedded server has finished exiting. Capture
# the server's own PID before config loads, not $! (the frontend PID). A private
# per-launch directory also prevents nested editors from inheriting our marker
# (and ENVI_DEV: an envi started inside is production unless asked otherwise).
instance_dir="$(mktemp -d "${TMPDIR:-/tmp}/envi.XXXXXXXX")"
cleanup() {
  rm -f -- "$instance_dir/pid" "$instance_dir/reload"
  rmdir -- "$instance_dir"
}
trap cleanup EXIT
export ENVI_RELOAD_FILE="$instance_dir/reload"
export ENVI_INSTANCE_FILE="$instance_dir/pid"
rc=0
nvim --cmd 'lua local p = vim.env.ENVI_INSTANCE_FILE; vim.env.ENVI_INSTANCE_FILE = nil; vim.env.ENVI_DEV = nil; if p then vim.fn.writefile({tostring(vim.fn.getpid())}, p) end' "$@" || rc=$?

# This barrier also covers :Detach followed immediately by another envi. Never
# kill the server or delete its swaps. On timeout refuse to start a new writer.
if [ -s "$ENVI_INSTANCE_FILE" ]; then
  server_pid="$(cat "$ENVI_INSTANCE_FILE")"
  case "$server_pid" in
    '' | *[!0-9]* | 0 | 1) echo 'envi: invalid server PID; not starting another editor.' >&2; exit 1 ;;
  esac
  seconds="${ENVI_EXIT_TIMEOUT:-30}"
  case "$seconds" in
    '' | *[!0-9]*) seconds=30 ;;
  esac
  if [ "${#seconds}" -gt 3 ] || [ "$seconds" -lt 1 ] || [ "$seconds" -gt 120 ]; then seconds=30; fi
  seconds=$((10#$seconds))
  ticks=0
  while kill -0 "$server_pid" 2>/dev/null || [ -n "$(ps -p "$server_pid" -o pid= 2>/dev/null)" ]; do
    if [ "$ticks" -eq 0 ]; then
      echo "envi: waiting up to ${seconds}s for nvim server $server_pid to finish exiting…" >&2
    fi
    if [ "$ticks" -ge "$((seconds * 10))" ]; then
      echo "envi: nvim server $server_pid has not exited; not starting another editor. Wait for it to exit, then run envi again." >&2
      exit 1
    fi
    sleep 0.1
    ticks=$((ticks + 1))
  done
elif [ -f "$ENVI_RELOAD_FILE" ]; then
  echo 'envi: missing server PID; not starting another editor.' >&2
  exit 1
fi

# :reload writes the session name, then quits. Re-read the launcher on restart
# so launcher changes take effect too, but only after the server has gone.
# ENVI_DEV is still exported here, so a dev reload stays in its dev profile.
if [ -f "$ENVI_RELOAD_FILE" ]; then
  ENVI_RELOAD_SESSION="$(cat "$ENVI_RELOAD_FILE")"
  export ENVI_RELOAD_SESSION
  cleanup
  trap - EXIT
  unset ENVI_INSTANCE_FILE ENVI_RELOAD_FILE
  exec "$self" "$@"
fi
exit "$rc"
