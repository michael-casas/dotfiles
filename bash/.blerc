# ble.sh configuration
# Sourced automatically when ble.sh initializes in interactive bash

# Auto-suggest from history and completions
bleopt complete_auto_complete=1

# Menu-style tab completion
bleopt complete_menu_complete=1

# Auto-fill common prefixes from history
bleopt complete_auto_history=1

# Clean transient prompt (starship handles the prompt)
bleopt prompt_ps1_transient=trim

# Enable syntax highlighting
bleopt highlight_syntax=1
bleopt highlight_filename=1
bleopt highlight_variable=1
