{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "disable": true
    },
    "Conduit": {
      "options": {
        "n": 1,
        "temperature": 0,
        "top_p": 1
      }
    },
    "django-systems-architect": {
      "options": {
        "n": 1,
        "temperature": 0.2,
        "top_p": 1
      }
    },
    "general": {
      "disable": true
    },
    "plan": {
      "disable": true
    },
    "Support": {
      "model": "lmstudio/qwen3.5-9b-mlx",
      "options": {
        "n": 1,
        "temperature": 0.3,
        "top_p": 1
      }
    }
  },
  "plugin": [
    "./plugins/cmux-session.js"
  ],
  "provider": {
    "lmstudio": {
      "models": {
        "qwen3.5-9b-mlx": {
          "name": "Qwen3.5 9B MLX"
        }
      },
      "options": {
        "baseURL": "http://localhost:1234/v1",
        "npm": "@ai-sdk/openai-compatible"
      }
    },
    "ollama": {
      "models": {
        "llama3.1:latest": {
          "name": "Llama 3.1"
        },
        "qwen2.5-coder:latest": {
          "name": "qwen2.5-coder"
        }
      },
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "npm": "@ai-sdk/openai-compatible"
      }
    }
  }
}
