{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "disable": true
    },
    "Researcher": {
      "model": "opencode-go/deepseek-v4-flash",
      "prompt": "You are a Lead Researcher. You send fan out lackey subagents n surfaces and they each generate markdown reports in .agent/reports/lackey/ then you combine them together for a full coverage report in .agent/reports/"
    },
    "lackey": {
      "model": "opencode-go/deepseek-v4-flash"
    },
    "Conduit": {
      "options": {
        "n": 1,
        "temperature": 0,
        "top_p": 1
      }
    },
    "django-systems-architect": {
      "options": {
        "n": 1,
        "temperature": 0.2,
        "top_p": 1
      }
    },
    "general": {
      "disable": true
    },
    "plan": {
      "disable": true
    },
    "Support": {
      "model": "lmstudio/qwen3.5-9b-mlx",
      "options": {
        "n": 1,
        "temperature": 0.3,
        "top_p": 1
      }
    }
  },
  "plugin": [
    "./plugins/cmux-session.js"
  ],
  "provider": {
    "lmstudio": {
      "models": {
        "qwen3.5-9b-mlx": {
          "name": "Qwen3.5 9B MLX"
        }
      },
      "options": {
        "baseURL": "http://localhost:1234/v1",
        "npm": "@ai-sdk/openai-compatible"
      }
    },
    "ollama": {
      "models": {
        "llama3.1:latest": {
          "name": "Llama 3.1"
        },
        "qwen2.5-coder:latest": {
          "name": "qwen2.5-coder"
        }
      },
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "npm": "@ai-sdk/openai-compatible"
      }
    },
    "j5-cliproxyapi": {
      "npm": "@ai-sdk/openai",
      "name": "J5 CLIProxyAPI",
      "options": {
        "baseURL": "http://192.168.1.174:8317/v1",
        "apiKey": "{file:~/.local/share/opencode/secrets/j5-cliproxyapi-key}"
      },
      "models": {
        "gpt-5.5": {
          "name": "gpt-5.5"
        },
        "gpt-6-sol": {
          "name": "gpt-6-sol"
        },
        "gpt-6.1-sol": {
          "name": "gpt-6.1-sol"
        },
        "gpt-6-luna": {
          "name": "gpt-6-luna"
        },
        "gpt-5.6-terra": {
          "name": "gpt-5.6-terra"
        },
        "gpt-6-astra": {
          "name": "gpt-6-astra"
        },
        "gpt-5.6-sol": {
          "name": "gpt-5.6-sol"
        },
        "gpt-5.6-luna": {
          "name": "gpt-5.6-luna"
        }
      }
    }
  }
}
